<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Celeste.Mod.mm's own TargetFramework: Everest moved off
         net452 onto modern .NET, loaded via NETCoreifier. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CelesteDashpad</AssemblyName>
    <RootNamespace>Celeste.Mod.Dashpad</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Everest mods reference the game's own assemblies; we don't ship or
         redistribute them, so never copy them into our output. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <CelestePath Condition="'$(CelestePath)' == ''">$(CELESTE_PATH)</CelestePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Celeste">
      <!-- Everest's MiniInstaller patches Celeste.exe into Celeste.dll,
           net8.0-hosted via a native apphost; not an .exe anymore. -->
      <HintPath>$(CelestePath)/Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(CelestePath)/FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Not referencing Celeste.Mod.mm.dll separately: MiniInstaller's
         AutoPatch step weaves its types (EverestModule, Celeste.Mod.*)
         directly into Celeste.dll, so referencing both throws CS0433
         (EverestModule defined in both). -->
    <!-- Generated by Everest's MiniInstaller (MonoMod HookGen) once
         installed into CELESTE_PATH. Run scripts/install-everest.sh first. -->
    <Reference Include="MMHOOK_Celeste">
      <HintPath>$(CelestePath)/MMHOOK_Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
