<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <AssemblyName>CelesteDashpad</AssemblyName>
    <RootNamespace>Celeste.Mod.Dashpad</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Everest mods reference the game's own assemblies; we don't ship or
         redistribute them, so never copy them into our output. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets `dotnet build` target net452 without a full .NET Framework
         install on Linux. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <CelestePath Condition="'$(CelestePath)' == ''">$(CELESTE_PATH)</CelestePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Celeste">
      <HintPath>$(CelestePath)/Celeste.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(CelestePath)/FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Generated by Everest's MiniInstaller (MonoMod HookGen) once
         installed into CELESTE_PATH. Run scripts/install-everest.sh first. -->
    <Reference Include="MMHOOK_Celeste">
      <HintPath>$(CelestePath)/MMHOOK_Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
